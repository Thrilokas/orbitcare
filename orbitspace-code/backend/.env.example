# Orbitspace backend — Supabase config
# Copy to .env (local) and set the same values in Vercel env vars.
# Get these from your Supabase project: Dashboard → Project Settings → API.
# NEVER put real keys in git. .env is git-ignored (see .gitignore note in README).
# The placeholders below are NOT real keys — replace them with your own.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
# Service-role key: server only, for seed + self-check writes.
# NEVER expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
PORT=3000
